# build.nvidia.com 에서 발급 (무료). 이 파일을 .env 로 복사해서 채운다 — .env 는 커밋되지 않는다.
NVIDIA_API_KEY=nvapi-...

# 선택 — 기본값은 한국어를 공식 지원하는 Nemotron 3 Ultra
# NIM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# 음성 전사 (loop/stt.py) — build.nvidia.com 호스팅 ASR. 키는 위의 NVIDIA_API_KEY 하나로 된다 — 아래는 전부 선택.
# STT_ENGINE=parakeet        # parakeet (nvidia/parakeet-1.1b-rnnt-multilingual-asr, 기본) | whisper (openai/whisper-large-v3)
# function-id 는 코드에 기본값이 있다. NVIDIA 가 모델을 재배포해 id 가 바뀌었을 때만 덮어쓴다.
# STT_FUNCTION_ID_PARAKEET=71203149-d3b7-4460-8231-1be2543a1fca
# STT_FUNCTION_ID_WHISPER=b702f636-f60c-4a3d-a6f4-f3568c13bd7d
# STT_LANGUAGE=ko-KR         # parakeet 기본 ko-KR, whisper 기본 ko (multi = 자동 감지)
# STT_BOOST=0                # 기본 0 = 단어 가중 없음. parakeet 만, data/contract.json 의 stt_keyterms 가중치.
#                            # 실측: 가중 0 → CER 4.4%, 2 → 8.8%, 5 → 51%, 10 → 109%. 2에서도 말한 «당뇨 적응증»을 환자군 «당뇨 전단계»로 적었다
# STT_SERVER=grpc.nvcf.nvidia.com:443

# 합성 음성 (loop/tts.py · 현장 수집 데모) — resembleai/chatterbox-multilingual-tts. 키는 같은 NVIDIA_API_KEY — 아래는 전부 선택.
# TTS_FUNCTION_ID=ddacc747-1269-4fab-bfd9-8f593dead106
# TTS_VOICE=Chatterbox-Multilingual.ko-KR.Male
# TTS_SERVER=grpc.nvcf.nvidia.com:443

# 현장 수집 화면이 가리키는 GitHub 저장소 — 없으면 git 원격(또는 Railway 변수)에서 owner/이름만 읽는다.
# COLLECT_GITHUB_REPO=owner/delphi-evidence-loop
# COLLECT_GITHUB_REF=main
