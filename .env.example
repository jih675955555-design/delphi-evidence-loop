# build.nvidia.com 에서 발급 (무료). 이 파일을 .env 로 복사해서 채운다 — .env 는 커밋되지 않는다.
NVIDIA_API_KEY=nvapi-...

# 선택 — 기본값은 한국어를 공식 지원하는 Nemotron 3 Ultra
# NIM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# 음성 전사 (loop/stt.py) — Nemotron 3.5 ASR, build.nvidia.com 호스팅. 키는 위의 NVIDIA_API_KEY 를 같이 쓴다.
# function-id 는 build.nvidia.com 의 Nemotron ASR 모델 페이지 → API 탭에서 복사한다. 이 값이 어떤 모델이 답할지 정한다.
# STT_FUNCTION_ID=
# STT_LANGUAGE=ko-KR
# STT_MODEL=nvidia/nemotron-3.5-asr-streaming     # 기록용 라벨 (캐시 키에 들어간다)
# STT_MODE=streaming                               # streaming | offline
# STT_BOOST=20                                     # data/contract.json 의 stt_keyterms 가중치
# STT_SERVER=grpc.nvcf.nvidia.com:443
